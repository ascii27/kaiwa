<FlashToast />
<div class="app-shell {{if this.sidebarCollapsed 'is-collapsed'}}">
  <UiSideNav
    @collapsed={{this.sidebarCollapsed}}
    @onToggle={{this.toggleSidebar}}
    @active={{this.currentRouteName}}
  />
  <main>
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h1 class="h5 mb-1"><span class="brand-label">Kaiwa</span></h1>
      </div>
      <div>
        {{#if this.session.token}}
          <span class="me-3 small text-muted">{{this.session.userEmail}}</span>
          <button type="button" class="btn btn-outline-secondary btn-sm" {{on "click" this.logout}}>Logout</button>
        {{else}}
          <LinkTo @route="auth" class="btn btn-outline-primary btn-sm">Log In</LinkTo>
        {{/if}}
      </div>
    </div>
    {{outlet}}
  </main>
</div>
